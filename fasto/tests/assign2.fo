fun int mul(int x, int y) =
    if x == 0 then
        0
    else if x < 0 then
        0-(mul(0-x, y))
    else
        y + mul(x - 1, y)

fun int main() =
    let n = read(int) in
    if n == 0 
        then let error = write("Wrong Input") in 0 
    else 
        let z = iota(n) in n
