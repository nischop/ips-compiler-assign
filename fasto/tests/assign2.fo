
//QUESTIONS
// 1. Should you be able to have negative numbers in the array
// 2. How the fuck to do it wihout the index?

fun int mul(int x, int y) =
    if x == 0 then
        0
    else if x < 0 then
        0-(mul(0-x, y))
    else
        y + mul(x - 1, y)

fun int readInt(int d) = read(int)

fun int write_int(int x) = write(x)
fun [int] write_int_arr([int] x) = map(write_int, x)
    
fun int square(int x) = mul(x,x)
fun int plus(int x, int y) = x + y

fun int main() =
    let n = read(int) in
    if n == 0 then 
        let error = write("Incorrect Input!") in 0 
    else if 0 < n then 
        let arr = iota(n) in
        let w = map(readInt, arr) in
        let test = map(fn int (int x) => if x == 0 then w[0] - w[n-1] else w[x] - w[x-1], arr) in
        let aight = map(square, test) in
        let d = reduce(plus, 0, aight) in 
        let hmm = write_int(d) in 1
    else
        write("Array Length Cannot be negative")

